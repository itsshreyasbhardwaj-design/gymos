{
  "name": "gymos",
  "version": "0.1.0",
  "private": true,
  "description": "GymOS - a personal fitness operating system. Equipment-aware workouts, adaptive planning, flexible meal planning.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx tsx --tsconfig tsconfig.scripts.json scripts/migrate.ts",
    "db:seed": "npx tsx --tsconfig tsconfig.scripts.json scripts/seed.ts",
    "db:reset": "rm -f data/gymos.db data/gymos.db-shm data/gymos.db-wal && npm run db:migrate && npm run db:seed",
    "db:demo": "npx tsx --tsconfig tsconfig.scripts.json scripts/demo.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "validate:content": "npx tsx --tsconfig tsconfig.scripts.json scripts/validate-content.ts",
    "smoke:generator": "npx tsx --tsconfig tsconfig.scripts.json scripts/smoke-generator.ts",
    "e2e:setup": "GYMOS_DB_PATH=./data/e2e.db npx tsx --tsconfig tsconfig.scripts.json scripts/e2e-setup.ts",
    "e2e:server": "npm run e2e:setup && GYMOS_DB_PATH=./data/e2e.db next start -p 3210 -H 127.0.0.1"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "motion": "^12.43.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}